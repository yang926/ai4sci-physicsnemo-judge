# Install root:root 0440 as /etc/sudoers.d/ai4sci-judge-admin (no suffix).
# No wildcards, arbitrary arguments, shell, Python, systemctl, SQL, or SETENV.
ai4sci-judge ALL=(root) NOPASSWD: /usr/local/sbin/ai4sci-judge-control status, /usr/local/sbin/ai4sci-judge-control pause, /usr/local/sbin/ai4sci-judge-control quiesce, /usr/local/sbin/ai4sci-judge-control resume
